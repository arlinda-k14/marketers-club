{
  "name": "marketers-club",
  "version": "1.0.0",
  "description": "Marketers Club - career-first marketing hub",
  "type": "commonjs",
  "main": "server/app.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/app.js",
    "dev": "node scripts/build.mjs && node server/app.js",
    "serve": "node server/app.js",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "seed:live": "node scripts/live/seed-firestore.cjs",
    "deploy:live": "npm run build && firebase deploy --only firestore,hosting --project marketers-club --non-interactive",
    "leads:draft": "node scripts/live/draft-lead-replies.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^11.0.2",
    "firebase-admin": "^12.6.0",
    "openai": "^4.73.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.48.2",
    "vite": "^5.4.10"
  }
}
